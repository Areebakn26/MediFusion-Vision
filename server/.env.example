# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DB_NAME=medifusionvision
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@medifusion.com

# Email Notifications (Gmail recommended)
# Instructions for Gmail:
# 1. Enable 2-Step Verification in your Google Account settings
# 2. Go to Security -> 2-Step Verification -> App passwords
# 3. Generate a 16-character App Password
# 4. Use your regular Gmail address for EMAIL_USER and the App Password for EMAIL_PASS

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password


# Jitsi (Optional - for custom domain)
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=your_jitsi_app_id
JITSI_SECRET=your_jitsi_secret

# Frontend URL
CLIENT_URL=http://localhost:5173

# Groq (AI Note-Taker — free tier, no credit card needed)
# Sign up at console.groq.com → API Keys → Create API Key
# Models used: whisper-large-v3-turbo (transcription) + llama-3.3-70b-versatile (notes)
GROQ_API_KEY=gsk_your_groq_api_key_here
